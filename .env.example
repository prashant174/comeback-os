# Used by docker-compose. For local (non-Docker) dev, use backend/.env instead.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-plus-random-hex-characters-access
JWT_REFRESH_SECRET=replace-with-64-plus-random-hex-characters-refresh
ALLOW_REGISTRATION=true
# Port the web app is exposed on
WEB_PORT=8080
# Set true only when serving over HTTPS
COOKIE_SECURE=false
CLIENT_URL=http://localhost:8080
